# CampusFix Environment Configuration Template
# Copy this file to .env and adjust the settings for your environment

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusfix
DB_USER=root
DB_PASS=

# Initial Admin Setup Credentials (used by admin/create_admin.php)
ADMIN_NAME="CampusFix Admin"
ADMIN_EMAIL=admin@campusfix.local
ADMIN_PASSWORD=Admin@12345

# Application Settings
APP_NAME=CampusFix
APP_ENV=development

